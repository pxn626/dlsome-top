{
  "_meta": {
    "schema_version": "1.0",
    "tool_name": "JSONPath Tester — Sample JSON Examples",
    "tool_name_zh": "JSONPath 在线测试器 — 示例 JSON",
    "last_updated": "2026-08-11",
    "disclaimer_en": "Sample JSON adapted from public documentation; refer to original sources for production use.",
    "disclaimer_zh": "示例 JSON 改编自公开文档,生产环境请参考原始来源。",
    "source_urls": {
      "stefan_gossner_jsonpath": "https://goessner.net/articles/JsonPath/",
      "shopify_api_docs": "https://shopify.dev/docs/api",
      "github_rest_api": "https://docs.github.com/en/rest"
    }
  },
  "examples": [
    {
      "id": "sample-store",
      "label_en": "Sample Store (Stefan Gössner Original)",
      "label_zh": "样例商店 (Stefan Gössner 原文)",
      "source": "Stefan Gössner 2007 verbatim",
      "source_url": "https://goessner.net/articles/JsonPath/",
      "json": {
        "store": {
          "book": [
            { "category": "reference", "title": "Sayings of the Century", "price": 18.9, "author": "Nigel Rees" },
            { "category": "fiction", "title": "Sword of Honour", "price": 12.99, "author": "Evelyn Waugh" },
            { "category": "fiction", "title": "Moby Dick", "price": 8.99, "author": "Herman Melville" },
            { "category": "fiction", "title": "The Lord of the Rings", "price": 22.99, "author": "J. R. R. Tolkien" }
          ],
          "bicycle": { "color": "red", "price": 19.95 }
        }
      },
      "expressions": {
        "jsonpath": {
          "all_authors": "$.store.book[*].author",
          "cheap_books": "$.store.book[?(@.price < 10)]",
          "all_prices_recursive": "$..price"
        },
        "jsonata": {
          "all_authors": "store.book.author",
          "cheap_books": "store.book[price < 10]",
          "total_price": "$sum(store.book.price)"
        },
        "jmespath": {
          "all_authors": "store.book[*].author",
          "cheap_books": "store.book[?price < `10`]",
          "all_prices_recursive": "store.book[*].price"
        }
      }
    },
    {
      "id": "user-profile",
      "label_en": "User Profile (nested objects)",
      "label_zh": "用户档案 (嵌套对象)",
      "source": "Self-implemented for testing",
      "source_url": "",
      "json": {
        "user": {
          "id": "u_12345",
          "name": "Alice Chen",
          "email": "alice@example.com",
          "address": {
            "city": "Shenzhen",
            "country": "CN",
            "geo": { "lat": 22.5431, "lng": 114.0579 }
          },
          "tags": ["admin", "developer", "founder"]
        }
      },
      "expressions": {
        "jsonpath": {
          "city": "$.user.address.city",
          "all_tags": "$.user.tags[*]",
          "geo_lat": "$.user.address.geo.lat"
        },
        "jsonata": {
          "city": "user.address.city",
          "all_tags": "user.tags",
          "geo_lat": "user.address.geo.lat"
        },
        "jmespath": {
          "city": "user.address.city",
          "all_tags": "user.tags",
          "geo_lat": "user.address.geo.lat"
        }
      }
    },
    {
      "id": "api-response",
      "label_en": "API Response (pagination)",
      "label_zh": "API 响应 (分页)",
      "source": "GitHub REST API pagination simplified",
      "source_url": "https://docs.github.com/en/rest",
      "json": {
        "code": 200,
        "message": "OK",
        "data": {
          "items": [
            { "id": 1, "name": "Item A", "status": "active" },
            { "id": 2, "name": "Item B", "status": "inactive" },
            { "id": 3, "name": "Item C", "status": "active" }
          ],
          "pagination": { "page": 1, "per_page": 20, "total": 3 }
        }
      },
      "expressions": {
        "jsonpath": {
          "active_items": "$.data.items[?(@.status == 'active')]",
          "all_ids": "$.data.items[*].id"
        },
        "jsonata": {
          "active_items": "data.items[status = 'active']",
          "all_ids": "data.items.id"
        },
        "jmespath": {
          "active_items": "data.items[?status == 'active']",
          "all_ids": "data.items[*].id"
        }
      }
    },
    {
      "id": "shopify-order",
      "label_en": "Shopify Order (e-commerce)",
      "label_zh": "Shopify 订单 (电商)",
      "source": "Shopify Admin API Order simplified",
      "source_url": "https://shopify.dev/docs/api",
      "json": {
        "order": {
          "id": 450789469,
          "email": "bob.norman@hostmail.com",
          "total_price": "199.65",
          "currency": "USD",
          "line_items": [
            { "title": "Awesome Bronze Hat", "quantity": 1, "price": "75.00" },
            { "title": "Awesome Leather Bag", "quantity": 2, "price": "62.32" }
          ],
          "shipping_address": { "city": "Toronto", "province": "Ontario", "country": "Canada" }
        }
      },
      "expressions": {
        "jsonpath": {
          "all_item_titles": "$.order.line_items[*].title",
          "shipping_city": "$.order.shipping_address.city"
        },
        "jsonata": {
          "all_item_titles": "order.line_items.title",
          "shipping_city": "order.shipping_address.city"
        },
        "jmespath": {
          "all_item_titles": "order.line_items[*].title",
          "shipping_city": "order.shipping_address.city"
        }
      }
    }
  ]
}
    {
      "id": "jsonplaceholder-user",
      "category": "test",
      "label_en": "JSONPlaceholder User",
      "label_zh": "JSONPlaceholder 用户",
      "draft": "draft-2020-12",
      "icon": "👤",
      "description_en": "Single user object from JSONPlaceholder demo API (public domain).",
      "description_zh": "JSONPlaceholder 示例 API 单个用户对象(公共域)。",
      "source_url": "https://jsonplaceholder.typicode.com/users",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "address": {
            "type": "object",
            "properties": {
              "street": {
                "type": "string"
              },
              "suite": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "zipcode": {
                "type": "string",
                "pattern": "^[0-9-]+$"
              },
              "geo": {
                "type": "object",
                "properties": {
                  "lat": {
                    "type": "string"
                  },
                  "lng": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "phone": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-_.]+(\\.[a-zA-Z]{2,})(/.*)?$"
          },
          "company": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "catchPhrase": {
                "type": "string"
              },
              "bs": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "id",
          "name",
          "username",
          "email"
        ]
      },
      "sample_data": {
        "id": 1,
        "name": "Leanne Graham",
        "username": "Bret",
        "email": "Sincere@april.biz",
        "address": {
          "street": "Kulas Light",
          "suite": "Apt. 556",
          "city": "Gwenborough",
          "zipcode": "92998-3874",
          "geo": {
            "lat": "-37.3159",
            "lng": "81.1496"
          }
        },
        "phone": "1-770-736-8031 x56442",
        "website": "hildegard.org",
        "company": {
          "name": "Romaguera-Crona",
          "catchPhrase": "Multi-layered client-server neural-net",
          "bs": "harness real-time e-markets"
        }
      }
    },
    {
      "id": "openapi-petstore-3-0",
      "category": "openapi",
      "label_en": "OpenAPI Petstore 3.0",
      "label_zh": "OpenAPI Petstore 3.0",
      "draft": "draft-7",
      "icon": "🌐",
      "description_en": "Simplified OpenAPI 3.0 Petstore (Apache 2.0).",
      "description_zh": "OpenAPI 3.0 Petstore 简化版(Apache 2.0)。",
      "source_url": "https://github.com/OAI/OpenAPI-Specification/blob/main/examples/v3.0/petstore.yaml",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "openapi": {
            "type": "string",
            "pattern": "^3\\.0\\."
          },
          "info": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "version"
            ]
          },
          "paths": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "components": {
            "type": "object",
            "properties": {
              "schemas": {
                "type": "object"
              }
            }
          }
        },
        "required": [
          "openapi",
          "info",
          "paths"
        ]
      },
      "sample_data": {
        "openapi": "3.0.0",
        "info": {
          "title": "Petstore",
          "version": "1.0.0",
          "description": "Sample OpenAPI 3.0 Petstore"
        },
        "paths": {
          "/pets": {
            "get": {
              "summary": "List pets",
              "responses": {
                "200": {
                  "description": "OK"
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "Pet": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },

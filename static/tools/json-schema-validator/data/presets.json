          }
        },
        "required": [
          "version",
          "configurations"
        ]
      },
      "sample_data": {
        "version": "0.2.0",
        "configurations": [
          {
            "type": "pwa-node",
            "request": "launch",
            "name": "Launch Program",
            "program": "${workspaceFolder}/src/index.js",
            "args": [
              "--env=dev"
            ],
            "env": {
              "NODE_ENV": "development"
            },
            "preLaunchTask": "build"
          }
        ]
      }
    },
    {
      "id": "github-actions-workflow",
      "category": "config",
      "label_en": "GitHub Actions workflow",
      "label_zh": "GitHub Actions workflow",
      "draft": "draft-2020-12",
      "icon": "⚡",
      "description_en": "Simplified GitHub Actions workflow schema (SchemaStore MIT derived).",
      "description_zh": "GitHub Actions workflow 简化版 schema(基于 SchemaStore MIT)。",
      "source_url": "https://json.schemastore.org/github-workflow.json",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "on": {
            "type": "object",
            "properties": {
              "push": {
                "type": "object"
              },
              "pull_request": {
                "type": "object"
              },
              "schedule": {
                "type": "array"
              },
              "workflow_dispatch": {
                "type": "object"
              }
            }
          },
          "jobs": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "runs-on": {
                  "type": "string"
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uses": {
                        "type": "string"
                      },
                      "run": {
                        "type": "string"
                      },
                      "with": {
                        "type": "object"
                      },
                      "env": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "required": [
                "runs-on",
                "steps"
              ]
            }
          }
        },
        "required": [
          "jobs"
        ]
      },
      "sample_data": {
        "name": "CI",
        "on": {
          "push": {
            "branches": [
              "main"
            ]
          },
          "pull_request": {
            "branches": [
              "main"
            ]
          },
          "schedule": [
            {
              "cron": "0 0 * * *"
            }
          ],
          "workflow_dispatch": {}
        },
        "jobs": {
          "build": {
            "runs-on": "ubuntu-latest",
            "steps": [
              {
                "uses": "actions/checkout@v4"
              },
              {
                "uses": "actions/setup-node@v4",
                "with": {
                  "node-version": "20"
                }
              },
              {
                "run": "npm ci",
                "env": {
                  "CI": "true"
                }
              },
              {
                "run": "npm test"
              }
            ]
          }
        }
      }
    },
    {
      "id": "kubernetes-pod",
      "category": "config",
      "label_en": "Kubernetes Pod manifest",
      "label_zh": "Kubernetes Pod manifest",
      "draft": "draft-2020-12",
      "icon": "☸️",
      "description_en": "Self-implemented simplified Kubernetes Pod manifest (full SchemaStore K8s is too large for browser).",
      "description_zh": "自实现简化版 Kubernetes Pod manifest(完整 SchemaStore K8s schema 过大不适合浏览器)。",
      "source_url": "https://json.schemastore.org/kubernetes-pod.json (full, MIT); simplified by dlsome-top",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "kind": {
            "type": "string",
            "const": "Pod"
          },
          "metadata": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name"
            ]
          },
          "spec": {
            "type": "object",
            "properties": {
              "containers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "ports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "containerPort": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535
                          },
                          "protocol": {
                            "type": "string",
                            "enum": [
                              "TCP",
                              "UDP",
                              "SCTP"
                            ]
                          }
                        },
                        "required": [
                          "containerPort"
                        ]
                      }
                    },
                    "env": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "value": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "name",
                    "image"
                  ]
                },
                "minItems": 1
              }
            },
            "required": [
              "containers"
            ]
          }
        },
        "required": [
          "apiVersion",
          "kind",
          "metadata",
          "spec"
        ]
      },
      "sample_data": {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "nginx-pod",
          "namespace": "default",
          "labels": {
            "app": "nginx"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "nginx",
              "image": "nginx:1.25",
              "ports": [
                {
                  "containerPort": 80,
                  "protocol": "TCP"
                }
              ],
              "env": [
                {
                  "name": "ENV",
                  "value": "production"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "id": "prometheus-alert-rule",
      "category": "api",
      "label_en": "Prometheus Alert Rule",
      "label_zh": "Prometheus 告警规则",
      "draft": "draft-2020-12",
      "icon": "🔥",
      "description_en": "Simplified Prometheus alerting rule schema (Apache 2.0).",
      "description_zh": "Prometheus 告警规则简化版 schema(Apache 2.0)。",
      "source_url": "https://prometheus.io/docs/prometheus/latest/configuration/alerting_rules/",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "interval": {
                  "type": "string"
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "alert": {
                        "type": "string"
                      },
                      "expr": {
                        "type": "string",
                        "minLength": 1
                      },
                      "for": {
                        "type": "string"
                      },
                      "labels": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "annotations": {
                        "type": "object",
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "alert",
                      "expr"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "rules"
              ]
            }
          }
        },
        "required": [
          "groups"
        ]
      },
      "sample_data": {
        "groups": [
          {
            "name": "example",
            "interval": "30s",
            "rules": [
              {
                "alert": "HighRequestLatency",
                "expr": "job:request_latency_seconds:mean5m{job=\"myjob\"} > 0.5",
                "for": "10m",
                "labels": {
                  "severity": "page"
                },
                "annotations": {
                  "summary": "High request latency",
                  "description": "Request latency is above 500ms"
                }
              }
            ]
          }
        ]
      }
    },

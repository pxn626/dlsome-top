      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^0\\.2\\."
          },
          "configurations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "node",
                    "chrome",
                    "pwa-node",
                    "pwa-chrome"
                  ]
                },
                "request": {
                  "type": "string",
                  "enum": [
                    "launch",
                    "attach"
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "program": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "preLaunchTask": {
                  "type": "string"
                },
                "presentation": {
                  "type": "object"
                }

    {
      "id": "package-json",
      "category": "config",
      "label_en": "package.json (npm)",
      "label_zh": "package.json (npm)",
      "draft": "draft-2020-12",
      "icon": "📦",
      "description_en": "Simplified npm package.json schema (SchemaStore MIT derived).",
      "description_zh": "npm package.json 简化版 schema(基于 SchemaStore MIT)。",
      "source_url": "https://json.schemastore.org/package.json",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^(?:@[a-z0-9-_][a-z0-9-_.]*\\/)?[a-z0-9-_][a-z0-9-_.]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
          },
          "description": {
            "type": "string"
          },
          "main": {
            "type": "string"
          },
          "scripts": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "devDependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "engines": {
            "type": "object"
          },
          "license": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "version"
        ]
      },
      "sample_data": {
        "name": "jsv-json-schema-validator",
        "version": "1.0.0",
        "description": "Browser-based JSON Schema Validator with ajv 8.x",
        "main": "jsv.js",
        "scripts": {
          "test": "node smoke-test.js",
          "build": "esbuild --bundle"
        },
        "dependencies": {
          "ajv": "^8.17.0",
          "ajv-formats": "^3.0.1",
          "ajv-draft-04": "^1.0.0",
          "ajv-i18n": "^4.2.0"
        },
        "devDependencies": {
          "esbuild": "^0.21.0"
        },
        "engines": {
          "node": ">=18.0.0"
        },
        "license": "MIT",
        "keywords": [
          "json-schema",
          "validator",
          "ajv",
          "browser"
        ]
      }
    },
    {
      "id": "tsconfig-json",
      "category": "config",
      "label_en": "tsconfig.json (TypeScript)",
      "label_zh": "tsconfig.json (TypeScript)",
      "draft": "draft-2020-12",
      "icon": "🔷",
      "description_en": "Simplified TypeScript tsconfig.json schema (SchemaStore MIT derived).",
      "description_zh": "TypeScript tsconfig.json 简化版 schema(基于 SchemaStore MIT)。",
      "source_url": "https://json.schemastore.org/tsconfig.json",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "compilerOptions": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string",
                "enum": [
                  "ES3",
                  "ES5",
                  "ES6",
                  "ES2015",
                  "ES2016",
                  "ES2017",
                  "ES2018",
                  "ES2019",
                  "ES2020",
                  "ES2021",
                  "ES2022",
                  "ESNext"
                ]
              },
              "module": {
                "type": "string",
                "enum": [
                  "CommonJS",
                  "AMD",
                  "System",
                  "UMD",
                  "ES6",
                  "ES2015",
                  "ES2020",
                  "ES2022",
                  "ESNext",
                  "Node16",
                  "NodeNext"
                ]
              },
              "strict": {
                "type": "boolean"
              },
              "esModuleInterop": {
                "type": "boolean"
              },
              "skipLibCheck": {
                "type": "boolean"
              },
              "forceConsistentCasingInFileNames": {
                "type": "boolean"
              },
              "resolveJsonModule": {
                "type": "boolean"
              },
              "paths": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "sample_data": {
        "compilerOptions": {
          "target": "ES2020",
          "module": "ESNext",
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "forceConsistentCasingInFileNames": true,
          "resolveJsonModule": true,
          "paths": {
            "@/*": [
              "src/*"
            ]
          }
        },
        "include": [
          "src/**/*"
        ],
        "exclude": [
          "node_modules",
          "dist"
        ]
      }
    },
